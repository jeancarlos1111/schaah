<!-- Modal de Optimización Automática de Horarios (Solver UBV) -->
<div id="modal-solver" class="uk-modal-container" uk-modal>
  <div class="uk-modal-dialog uk-modal-body modal-clean-box" style="max-width: 960px; padding: 2rem;">
    <button class="uk-modal-close-default" type="button" uk-close></button>

    <!-- Cabecera del Solver -->
    <div class="uk-margin-small-bottom">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
        <span class="badge-clean-primary font-mono text-xs">MOTOR SOLVER UBV</span>
        <span class="badge-clean-success font-mono text-xs">H-01 a H-09 / S-01 a S-05</span>
      </div>
      <h2 class="panel-title uk-margin-remove">Optimización Automática de Horarios</h2>
      <p class="panel-subtitle uk-margin-xsmall-top">
        Calendarización algorítmica para las secciones vacantes del período <strong class="text-white"><%= periodoCodigo %></strong> sin solapamientos docentes ni de aulas.
      </p>
    </div>

    <hr class="uk-divider-small uk-margin-small-top uk-margin-medium-bottom" style="border-color: var(--border-subtle);" />

    <!-- ESTADO 1: DIAGNÓSTICO Y CONFIGURACIÓN -->
    <div id="solver-step-config">
      <div class="uk-grid-small uk-child-width-1-2 uk-child-width-1-4@m uk-margin-bottom" uk-grid>
        <div>
          <div class="clean-stat-card" style="padding: 0.85rem;">
            <span class="stat-category">Secciones Vacantes</span>
            <div class="stat-value-row">
              <span class="stat-number" id="solver-metric-secciones">--</span>
              <span class="stat-unit">secciones</span>
            </div>
            <span class="detail-label">Sin horario fijado</span>
          </div>
        </div>

        <div>
          <div class="clean-stat-card" style="padding: 0.85rem;">
            <span class="stat-category">Bloques Requeridos</span>
            <div class="stat-value-row">
              <span class="stat-number" id="solver-metric-bloques">--</span>
              <span class="stat-unit">sesiones 90m</span>
            </div>
            <span class="detail-label" id="solver-metric-horas">-- horas académicas</span>
          </div>
        </div>

        <div>
          <div class="clean-stat-card" style="padding: 0.85rem;">
            <span class="stat-category">Docentes con Disponibilidad</span>
            <div class="stat-value-row">
              <span class="stat-number" id="solver-metric-docentes">--</span>
              <span class="stat-unit" id="solver-metric-docentes-total">de --</span>
            </div>
            <span class="detail-label" id="solver-metric-sin-docente">Franjas declaradas en el período</span>
          </div>
        </div>

        <div>
          <div class="clean-stat-card" style="padding: 0.85rem;">
            <span class="stat-category">Factibilidad Base</span>
            <div class="stat-value-row">
              <span class="stat-number" id="solver-metric-status">--</span>
            </div>
            <span class="detail-label" id="solver-metric-status-detalle">Calculando diagnóstico</span>
          </div>
        </div>
      </div>

      <div id="solver-alert-diagnostico" class="alert-clean-warning alert-clean-lista uk-margin-bottom uk-hidden">
        <span uk-icon="icon: warning; ratio: 0.85" class="uk-margin-xsmall-right"></span>
        <span>Estas secciones quedarán sin programar o incompletas si no se corrigen antes de optimizar:</span>
        <ul id="solver-diagnostico-lista" class="solver-infactible-lista"></ul>
      </div>

      <!-- Parámetros del Algoritmo -->
      <div class="uk-card uk-card-default uk-card-body uk-margin-bottom" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-subtle); border-radius: 8px; padding: 1.25rem;">
        <h4 class="text-sm font-semibold text-white uk-margin-small-bottom">Parámetros de Optimización</h4>
        <div class="uk-grid-small uk-child-width-1-3@m uk-child-width-1-1@s" uk-grid>
          <div>
            <label class="label-clean text-xs">Motor de Optimización</label>
            <select id="solver-param-motor" class="table-filter-select" style="width: 100%; height: 38px;">
              <option value="CP_SAT" selected>Google OR-Tools CP-SAT (WebAssembly)</option>
              <option value="GENETICO">Algoritmo Genético + LNS (Nativo TS)</option>
            </select>
          </div>
          <div>
            <label class="label-clean text-xs">Estrategia / Generaciones</label>
            <select id="solver-param-estrategia" class="table-filter-select" style="width: 100%; height: 38px;">
              <option value="rapido">Rápida (40 gen / ~500ms)</option>
              <option value="profundo" selected>Profunda / LNS (80 gen / ~1.2s)</option>
              <option value="exhaustivo">Exhaustiva (150 gen / ~3.0s)</option>
            </select>
          </div>
          <div>
            <label class="label-clean text-xs">Acción Posterior</label>
            <div class="uk-margin-small-top">
              <label class="text-xs text-muted" style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                <input type="checkbox" id="solver-param-autoaplicar" class="uk-checkbox" style="border-radius: 4px;" />
                <span>Aplicar a BD si es factible</span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <!-- Mensaje de aviso de secciones vacantes -->
      <div id="solver-alert-vacio" class="alert-clean-warning uk-margin-bottom uk-hidden">
        <span uk-icon="icon: info; ratio: 0.85" class="uk-margin-xsmall-right"></span>
        <span>Todas las secciones de este período ya tienen horarios asignados. No hay vacantes por calendarizar.</span>
      </div>

      <div class="uk-flex uk-flex-between uk-flex-middle uk-margin-small-top">
        <button class="btn-clean-ghost uk-modal-close" type="button">
          <span>Cancelar</span>
        </button>
        <button id="btn-ejecutar-solver" class="btn-clean-primary" type="button" onclick="ejecutarSolver()">
          <span uk-icon="icon: bolt; ratio: 0.85"></span>
          <span>Iniciar Optimización Automática</span>
        </button>
      </div>
    </div>

    <!-- ESTADO 2: PROCESAMIENTO / LOADING -->
    <div id="solver-step-loading" class="uk-hidden uk-text-center uk-padding-large">
      <div uk-spinner="ratio: 2" class="uk-margin-bottom" style="color: var(--brand-accent);"></div>
      <h3 class="text-white font-semibold uk-margin-xsmall-bottom">Ejecutando Motor Solver de Horarios</h3>
      <p class="text-muted text-sm uk-margin-remove-top" style="max-width: 500px; margin: 0 auto;">
        Evaluando matrices de aforo, disponibilidades declaradas, turnos y restricciones territoriales anti-teletransportación...
      </p>
      <div class="uk-margin-top uk-progress-clean" style="max-width: 400px; margin: 1.5rem auto 0; height: 6px; background: rgba(255,255,255,0.06); border-radius: 3px; overflow: hidden;">
        <div class="uk-progress-bar-animated" style="width: 100%; height: 100%; background: linear-gradient(90deg, var(--brand-accent), #38bdf8);"></div>
      </div>
    </div>

    <!-- ESTADO 3: RESULTADOS DE LA OPTIMIZACIÓN -->
    <div id="solver-step-results" class="uk-hidden">
      <!-- Barra superior de estado -->
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; padding: 0.75rem 1rem; background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: 6px;">
        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
          <span id="solver-badge-status" class="badge-clean-success font-semibold text-sm">FACTIBLE</span>
          <span class="text-xs text-muted" id="solver-metric-tiempo">Cómputo: 0 ms</span>
          <span class="text-xs text-muted" style="opacity: 0.4;">|</span>
          <span class="text-xs text-muted font-mono" id="solver-metric-asignadas">16 bloques asignados</span>
        </div>
        <div>
          <button class="btn-clean-ghost text-xs" type="button" onclick="volverAConfigSolver()">
            <span uk-icon="icon: refresh; ratio: 0.75"></span>
            <span>Re-ejecutar</span>
          </button>
        </div>
      </div>

      <!-- Alerta si hubo cuellos de botella -->
      <div id="solver-alert-infactible" class="alert-clean-danger alert-clean-lista uk-margin-bottom uk-hidden">
        <span uk-icon="icon: warning; ratio: 0.85" class="uk-margin-xsmall-right"></span>
        <span id="solver-infactible-msg">Conflictos detectados en el modelo.</span>
        <ul id="solver-infactible-lista" class="solver-infactible-lista"></ul>
      </div>

      <!-- Tabla de Asignaciones Propuestas -->
      <div class="uk-overflow-auto uk-margin-bottom" style="max-height: 400px; border: 1px solid var(--border-subtle); border-radius: 6px;">
        <table class="clean-table" style="margin: 0; width: 100%;">
          <thead>
            <tr>
              <th style="width: 18%;">Sección / Código</th>
              <th style="width: 25%;">Unidad Curricular</th>
              <th style="width: 22%;">Docente Asignado</th>
              <th style="width: 18%;">Día y Horario</th>
              <th style="width: 17%;">Espacio Físico</th>
            </tr>
          </thead>
          <tbody id="solver-tabla-body">
            <!-- Rellenado dinámicamente -->
          </tbody>
        </table>
      </div>

      <!-- Botones de Acción Final -->
      <div class="uk-flex uk-flex-between uk-flex-middle uk-margin-small-top">
        <button class="btn-clean-ghost uk-modal-close" type="button">
          <span>Cerrar</span>
        </button>
        <div class="uk-flex uk-flex-middle gap-2">
          <button id="btn-aplicar-solver" class="btn-clean-primary" type="button" onclick="aplicarHorariosSolver()">
            <span uk-icon="icon: check; ratio: 0.85"></span>
            <span>Confirmar y Aplicar a Base de Datos</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ESTADO 4: ÉXITO DE APLICACIÓN -->
    <div id="solver-step-success" class="uk-hidden uk-text-center uk-padding-large">
      <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.3); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem;">
        <span uk-icon="icon: check; ratio: 1.5" style="color: #22c55e;"></span>
      </div>
      <h3 class="text-white font-semibold uk-margin-xsmall-bottom">¡Horarios Asignados Exitosamente!</h3>
      <p class="text-muted text-sm uk-margin-remove-top" id="solver-success-msg">
        Se han guardado todos los bloques de horario y la auditoría correspondiente en el sistema.
      </p>
      <div class="uk-margin-medium-top">
        <button class="btn-clean-primary" type="button" onclick="window.location.reload()">
          <span uk-icon="icon: refresh; ratio: 0.85"></span>
          <span>Actualizar Vista de Horarios</span>
        </button>
      </div>
    </div>

  </div>
</div>

<script>
  let solverUltimoResultado = null;
  const periodoIdActivo = '<%= periodoId %>';
  const solverPfgId = <%- JSON.stringify(typeof filtroPfgId !== 'undefined' && filtroPfgId ? filtroPfgId : null) %>;

  function solverUrl(ruta) {
    const base = '/periodos/' + periodoIdActivo + '/solver/' + ruta;
    if (!solverPfgId) return base;
    return base + (base.includes('?') ? '&' : '?') + 'pfgId=' + encodeURIComponent(solverPfgId);
  }

  async function abrirModalSolver() {
    UIkit.modal('#modal-solver').show();
    document.getElementById('solver-step-config').classList.remove('uk-hidden');
    document.getElementById('solver-step-loading').classList.add('uk-hidden');
    document.getElementById('solver-step-results').classList.add('uk-hidden');
    document.getElementById('solver-step-success').classList.add('uk-hidden');

    try {
      const res = await fetch(solverUrl('diagnostico'), {
        headers: { 'Accept': 'application/json' }
      });
      const data = await res.json();
      if (data.ok) {
        document.getElementById('solver-metric-secciones').textContent = data.metricas.seccionesPendientes;
        document.getElementById('solver-metric-bloques').textContent = data.metricas.totalBloquesRequeridos;
        document.getElementById('solver-metric-horas').textContent = data.metricas.totalHorasPendientes + ' horas académicas';
        document.getElementById('solver-metric-docentes').textContent = data.metricas.docentesConDisponibilidad;
        document.getElementById('solver-metric-docentes-total').textContent = 'de ' + data.metricas.docentesAsignados + ' docentes';
        document.getElementById('solver-metric-sin-docente').textContent = data.metricas.seccionesSinProfesor > 0
          ? data.metricas.seccionesSinProfesor + ' secciones sin docente asignado'
          : 'Franjas declaradas en el período';

        const estado = document.getElementById('solver-metric-status');
        const alertaDiagnostico = document.getElementById('solver-alert-diagnostico');
        const listaDiagnostico = document.getElementById('solver-diagnostico-lista');
        listaDiagnostico.innerHTML = '';
        if (data.factible) {
          estado.textContent = 'OK';
          estado.className = 'stat-number text-green';
          document.getElementById('solver-metric-status-detalle').textContent = 'Docentes y aulas suficientes';
          alertaDiagnostico.classList.add('uk-hidden');
        } else {
          estado.textContent = 'REVISAR';
          estado.className = 'stat-number text-red';
          document.getElementById('solver-metric-status-detalle').textContent = data.avisos.length + ' avisos por corregir';
          data.avisos.forEach(function(aviso) {
            const li = document.createElement('li');
            li.textContent = aviso;
            listaDiagnostico.appendChild(li);
          });
          alertaDiagnostico.classList.remove('uk-hidden');
        }

        if (data.metricas.seccionesPendientes === 0) {
          document.getElementById('solver-alert-vacio').classList.remove('uk-hidden');
          document.getElementById('btn-ejecutar-solver').disabled = true;
        } else {
          document.getElementById('solver-alert-vacio').classList.add('uk-hidden');
          document.getElementById('btn-ejecutar-solver').disabled = false;
        }
      }
    } catch (err) {
      console.error('Error cargando diagnóstico:', err);
    }
  }

  function volverAConfigSolver() {
    document.getElementById('solver-step-config').classList.remove('uk-hidden');
    document.getElementById('solver-step-results').classList.add('uk-hidden');
    document.getElementById('solver-step-loading').classList.add('uk-hidden');
    document.getElementById('solver-step-success').classList.add('uk-hidden');
  }

  async function ejecutarSolver() {
    document.getElementById('solver-step-config').classList.add('uk-hidden');
    document.getElementById('solver-step-loading').classList.remove('uk-hidden');

    const motor = document.getElementById('solver-param-motor').value;
    const estrategia = document.getElementById('solver-param-estrategia').value;
    const autoAplicar = document.getElementById('solver-param-autoaplicar').checked;

    let maxGeneraciones = 80;
    let tamanoPoblacion = 40;
    if (estrategia === 'rapido') {
      maxGeneraciones = 40;
      tamanoPoblacion = 25;
    } else if (estrategia === 'exhaustivo') {
      maxGeneraciones = 150;
      tamanoPoblacion = 60;
    }

    try {
      const res = await fetch(solverUrl('ejecutar'), {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify({
          motor,
          autoAplicar,
          maxGeneraciones,
          tamanoPoblacion,
          ...(solverPfgId ? { pfgId: solverPfgId } : {}),
        }),
      });

      const data = await res.json();
      document.getElementById('solver-step-loading').classList.add('uk-hidden');

      if (!data.ok) {
        alert(data.error || 'Error al ejecutar solver');
        volverAConfigSolver();
        return;
      }

      solverUltimoResultado = data.resultado;

      if (autoAplicar && data.aplicados > 0) {
        // Se aplicó directamente
        document.getElementById('solver-step-success').classList.remove('uk-hidden');
        document.getElementById('solver-success-msg').textContent = data.mensaje;
        return;
      }

      // Mostrar Resultados
      document.getElementById('solver-step-results').classList.remove('uk-hidden');
      const badgeStatus = document.getElementById('solver-badge-status');
      if (data.resultado.status === 'OPTIMAL' || data.resultado.status === 'FEASIBLE') {
        badgeStatus.className = 'status-pill status-active font-semibold text-xs';
        badgeStatus.textContent = 'FACTIBLE (0 Conflictos Duros)';
        document.getElementById('btn-aplicar-solver').classList.remove('uk-hidden');
        document.getElementById('solver-alert-infactible').classList.add('uk-hidden');
      } else {
        badgeStatus.className = 'status-pill status-inactive font-semibold text-xs';
        badgeStatus.textContent = 'INFACTIBLE';
        document.getElementById('btn-aplicar-solver').classList.add('uk-hidden');
        document.getElementById('solver-alert-infactible').classList.remove('uk-hidden');
        const lista = document.getElementById('solver-infactible-lista');
        lista.innerHTML = '';
        (data.resultado.violacionesDuras || []).forEach(function(v) {
          const li = document.createElement('li');
          li.textContent = v.mensaje;
          lista.appendChild(li);
        });
      }

      const tiempoTexto = data.resultado.metricas.tiempoMs + ' ms';
      document.getElementById('solver-metric-tiempo').textContent = 'Cómputo: ' + tiempoTexto;
      document.getElementById('solver-metric-asignadas').textContent = data.resultado.totalBloquesAsignados + ' bloques asignados';

      // Renderizar tabla
      const tbody = document.getElementById('solver-tabla-body');
      tbody.innerHTML = '';

      data.resultado.asignaciones.forEach(function(asig) {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><span class="font-mono text-xs font-semibold text-white">${asig.codigoSeccion}</span></td>
          <td>
            <div class="text-sm font-medium text-white">${asig.nombreMateria}</div>
            <div class="text-xs text-muted">${asig.tipoBloque}</div>
          </td>
          <td>
            <div class="text-sm text-white">${asig.profesorNombre}</div>
          </td>
          <td>
            <span class="status-pill indicator-amber font-mono text-xs">${asig.dia}</span>
            <div class="text-xs text-muted uk-margin-xxsmall-top font-mono" style="margin-top: 3px;">${asig.horaInicio12} - ${asig.horaFin12}</div>
          </td>
          <td>
            <span class="status-pill indicator-blue font-mono text-xs">${asig.codigoEspacio}</span>
          </td>
        `;
        tbody.appendChild(tr);
      });

    } catch (err) {
      console.error('Error al ejecutar solver:', err);
      alert('Error de conexión con el servidor.');
      volverAConfigSolver();
    }
  }

  async function aplicarHorariosSolver() {
    if (!solverUltimoResultado || !solverUltimoResultado.asignaciones) return;

    const btn = document.getElementById('btn-aplicar-solver');
    btn.disabled = true;
    btn.innerHTML = '<span uk-spinner="ratio: 0.7"></span> Guardando...';

    try {
      const res = await fetch(solverUrl('aplicar'), {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify({
          propuesta: solverUltimoResultado,
          ...(solverPfgId ? { pfgId: solverPfgId } : {}),
        }),
      });

      const data = await res.json();
      if (data.ok) {
        document.getElementById('solver-step-results').classList.add('uk-hidden');
        document.getElementById('solver-step-success').classList.remove('uk-hidden');
        document.getElementById('solver-success-msg').textContent = data.mensaje;
      } else {
        alert(data.error || 'Error al aplicar horarios.');
        btn.disabled = false;
        btn.innerHTML = '<span uk-icon="icon: check; ratio: 0.85"></span> Confirmar y Aplicar a Base de Datos';
      }
    } catch (err) {
      console.error('Error aplicando horarios:', err);
      alert('Error de conexión al aplicar horarios.');
      btn.disabled = false;
      btn.innerHTML = '<span uk-icon="icon: check; ratio: 0.85"></span> Confirmar y Aplicar a Base de Datos';
    }
  }
</script>
