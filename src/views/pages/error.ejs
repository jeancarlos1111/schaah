<div class="uk-flex uk-flex-center uk-margin-large-top">
  <div class="uk-card uk-card-default uk-card-body uk-card-hover uk-width-large uk-text-center uk-border-rounded">
    <div class="uk-text-danger uk-margin-small-bottom">
      <span uk-icon="icon: ban; ratio: 3"></span>
    </div>
    <div class="uk-text-meta uk-text-bold">Código <%= typeof statusCode !== 'undefined' ? statusCode : 500 %></div>
    <h2 class="uk-card-title uk-text-bold uk-margin-small-top"><%= title %></h2>
    <p class="uk-text-muted"><%= typeof mensaje !== 'undefined' ? mensaje : (typeof error !== 'undefined' ? error : 'Ha ocurrido un error inesperado.') %></p>
    <div class="uk-margin-medium-top uk-flex uk-flex-center uk-grid-small" uk-grid>
      <div>
        <a href="/" class="uk-button uk-button-primary uk-border-rounded">
          <span uk-icon="icon: home; ratio: 0.8" class="uk-margin-xsmall-right"></span> Ir al Tablero
        </a>
      </div>
      <div>
        <a href="/logout" class="uk-button uk-button-default uk-border-rounded">Cerrar Sesión</a>
      </div>
    </div>
  </div>
</div>
