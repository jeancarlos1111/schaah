      </div>

      <div class="uk-grid-small uk-child-width-1-3" uk-grid>
        <div>
          <div class="form-group-clean">
            <label class="label-clean">Trayecto</label>
            <input type="number" name="trayecto" min="0" max="5" placeholder="0 a 5" class="input-control-clean" style="padding-left: 0.75rem;">
          </div>
        </div>
        <div>
          <div class="form-group-clean">
            <label class="label-clean">Tramo</label>
            <input type="number" name="tramo" min="0" max="10" placeholder="0 a 10" class="input-control-clean" style="padding-left: 0.75rem;">
          </div>
        </div>
        <div>
          <div class="form-group-clean">
            <label class="label-clean">Estudiantes</label>
            <input type="number" name="cantidadEstudiantes" min="1" max="500" placeholder="Matrícula" class="input-control-clean" style="padding-left: 0.75rem;">
          </div>
        </div>
      </div>

      <div class="uk-grid-small uk-child-width-1-3" uk-grid>
        <div>
          <div class="form-group-clean">
            <label class="label-clean">Turno</label>
            <select name="turno" class="table-filter-select form-select-full">
              <option value="">Según código (-M / -T / -N)</option>
              <% turnos.forEach(function(t) { %>
                <option value="<%= t %>"><%= etiquetaTurno[t] || t %></option>
              <% }); %>
