<!-- Header del Módulo de Secciones -->
<div class="page-header uk-margin-medium-bottom">
  <div class="uk-flex uk-flex-between uk-flex-middle uk-flex-wrap">
    <div>
      <div class="header-breadcrumbs uk-margin-xsmall-bottom">
        <a href="/periodos" class="uk-link-reset uk-text-muted">Períodos</a>
        <span class="breadcrumb-separator">/</span>
        <span class="active-crumb"><%= periodo.codigo %> - Oferta de Secciones</span>
      </div>
      <h1 class="page-title uk-margin-remove">Secciones y Oferta Académica (<%= periodo.codigo %>)</h1>
      <p class="page-subtitle uk-margin-xsmall-top">
        Administración de cohortes estudiantiles por Programa de Formación (PFG), asignación docente y cupos para el período <%= periodo.codigo %>.
      </p>
    </div>
    <div class="header-controls uk-margin-small-top uk-flex uk-flex-middle gap-2">
      <button class="btn-clean-secondary" type="button" onclick="abrirModalSolver()">
        <span uk-icon="icon: bolt; ratio: 0.85"></span>
        <span>Optimización Automática</span>
      </button>
      <a href="/periodos/<%= periodo.id %>/horarios" class="btn-clean-secondary">
        <span uk-icon="icon: table; ratio: 0.85"></span>
        <span>Ver Matriz de Horarios</span>
      </a>
      <button class="btn-clean-primary" uk-toggle="target: #modal-nueva-seccion">
        <span uk-icon="icon: plus; ratio: 0.85"></span>
        <span>Nueva Sección</span>
      </button>
    </div>
  </div>
</div>

<!-- Alertas de Feedback -->
<% if (typeof mensaje !== 'undefined' && mensaje) { %>
  <div class="alert-clean-success uk-margin-bottom" uk-alert>
    <a class="uk-alert-close" uk-close></a>
    <span uk-icon="icon: check; ratio: 0.85" class="uk-margin-xsmall-right"></span>
    <span><%= mensaje %></span>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert-clean-danger uk-margin-bottom" uk-alert>
    <a class="uk-alert-close" uk-close></a>
    <span uk-icon="icon: warning; ratio: 0.85" class="uk-margin-xsmall-right"></span>
    <span><%= error %></span>
  </div>
<% } %>

<!-- Bento Stat Cards de Oferta Académica (Diseño Canónico SAHAD) -->
<div class="uk-grid-small uk-child-width-1-2 uk-child-width-1-4@m uk-margin-medium-bottom" uk-grid>
  <div>
    <div class="clean-stat-card">
      <span class="stat-category">Total Secciones</span>
      <div class="stat-value-row">
        <span class="stat-number"><%= stats.totalSecciones %></span>
        <span class="stat-unit">secciones</span>
      </div>
      <span class="detail-label">Ofertadas en el lapso</span>
    </div>
  </div>

  <div>
    <div class="clean-stat-card">
      <span class="stat-category">Con Docente</span>
      <div class="stat-value-row">
        <span class="stat-number"><%= stats.conDocente %></span>
        <span class="stat-unit">asignadas</span>
      </div>
      <span class="detail-label">Profesor vinculado</span>
    </div>
  </div>

  <div>
    <div class="clean-stat-card">
      <span class="stat-category">Vacantes</span>
      <div class="stat-value-row">
        <span class="stat-number"><%= stats.sinDocente %></span>
        <span class="stat-unit">pendientes</span>
      </div>
      <span class="detail-label">Por asignar / solver</span>
    </div>
  </div>

  <div>
    <div class="clean-stat-card">
      <span class="stat-category">Matrícula Estimada</span>
      <div class="stat-value-row">
        <span class="stat-number"><%= stats.totalCupos %></span>
        <span class="stat-unit">estudiantes</span>
      </div>
      <span class="detail-label">Cupos globales proyectados</span>
    </div>
  </div>
</div>

<%
  // Helpers para URLs de ordenamiento y paginación en servidor (Spec 07)
  function makeQueryUrl(overrides) {
    const params = new URLSearchParams({
      page: overrides.page !== undefined ? overrides.page : pagination.page,
      limit: overrides.limit !== undefined ? overrides.limit : pagination.limit,
      q: overrides.q !== undefined ? overrides.q : (filters.q || ''),
      pfgId: overrides.pfgId !== undefined ? overrides.pfgId : (filters.pfgId || ''),
      turno: overrides.turno !== undefined ? overrides.turno : (filters.turno || ''),
      sedeId: overrides.sedeId !== undefined ? overrides.sedeId : (filters.sedeId || ''),
      docente: overrides.docente !== undefined ? overrides.docente : (filters.docente || ''),
      sortBy: overrides.sortBy !== undefined ? overrides.sortBy : (filters.sortBy || 'codigoSeccion'),
      sortDir: overrides.sortDir !== undefined ? overrides.sortDir : (filters.sortDir || 'asc')
    });
    for (const [key, val] of [...params.entries()]) {
      if (!val) params.delete(key);
    }
    return `/periodos/${periodo.id}/secciones?` + params.toString();
  }

  function getSortUrl(col) {
    const isCurrent = filters.sortBy === col;
    const nextDir = isCurrent && filters.sortDir === 'asc' ? 'desc' : 'asc';
    return makeQueryUrl({ page: 1, sortBy: col, sortDir: nextDir });
  }

  function getSortHeaderClass(col) {
    if (filters.sortBy !== col) return 'sortable';
    return filters.sortDir === 'asc' ? 'sortable sort-asc' : 'sortable sort-desc';
  }
%>

<!-- Panel Principal con Componente Reutilizable DataTable (Server-Side - Spec 07) -->
<div class="clean-panel data-table-wrapper" id="secciones-datatable-wrapper">
  
  <!-- Barra de Herramientas Server-Side Estable -->
  <form 
    id="secciones-filter-form"
    action="/periodos/<%= periodo.id %>/secciones"
    method="GET"
    class="table-toolbar uk-flex uk-flex-between uk-flex-middle uk-flex-wrap gap-2"
  >
    <input type="hidden" name="page" value="1" />
    <input type="hidden" name="sortBy" value="<%= filters.sortBy %>" />
    <input type="hidden" name="sortDir" value="<%= filters.sortDir %>" />

    <!-- Fila Superior: Búsqueda Global y Selector de Filas por Página -->
    <div class="uk-flex uk-flex-between uk-flex-middle uk-width-1-1 uk-margin-small-bottom">
      <!-- Input de Búsqueda Server-Side -->
      <div class="table-search-box" style="max-width: 380px;">
        <span uk-icon="icon: search; ratio: 0.8" class="search-icon"></span>
        <input 
          type="text" 
          name="q"
          id="secciones-search-input"
          value="<%= filters.q %>"
          class="search-input" 
          placeholder="Buscar por sección, materia o docente..." 
          autocomplete="off"
        />
      </div>

      <!-- Selector de Filas por Página -->
      <div class="table-toolbar-right uk-flex uk-flex-middle gap-2">
        <span class="uk-text-muted uk-text-small">Filas:</span>
        <select name="limit" class="table-page-size-select" onchange="this.form.submit()">
          <option value="5" <%= pagination.limit === 5 ? 'selected' : '' %>>5</option>
          <option value="10" <%= pagination.limit === 10 ? 'selected' : '' %>>10</option>
          <option value="25" <%= pagination.limit === 25 ? 'selected' : '' %>>25</option>
          <option value="50" <%= pagination.limit === 50 ? 'selected' : '' %>>50</option>
        </select>
      </div>
    </div>

    <!-- Fila Inferior: Filtros de Selección y Acción de Limpiar -->
    <div class="table-filters-row uk-flex uk-flex-middle uk-flex-wrap gap-2 uk-width-1-1">
      <!-- Filtro por PFG -->
      <select name="pfgId" class="table-filter-select" onchange="this.form.submit()">
        <option value="">Todos los PFG</option>
        <% pfgs.forEach(function(p) { %>
          <option value="<%= p.id %>" <%= filters.pfgId === p.id ? 'selected' : '' %>>
            <%= p.nombre %>
          </option>
        <% }); %>
      </select>

      <!-- Filtro por Turno -->
      <select name="turno" class="table-filter-select" onchange="this.form.submit()">
        <option value="">Todos los turnos</option>
        <option value="MATUTINO" <%= filters.turno === 'MATUTINO' ? 'selected' : '' %>>Matutino</option>
        <option value="VESPERTINO" <%= filters.turno === 'VESPERTINO' ? 'selected' : '' %>>Vespertino</option>
        <option value="NOCTURNO" <%= filters.turno === 'NOCTURNO' ? 'selected' : '' %>>Nocturno</option>
        <option value="FIN_DE_SEMANA" <%= filters.turno === 'FIN_DE_SEMANA' ? 'selected' : '' %>>Fin de Semana</option>
      </select>

      <!-- Filtro por Sede -->
      <select name="sedeId" class="table-filter-select" onchange="this.form.submit()">
        <option value="">Todas las sedes</option>
        <% sedes.forEach(function(s) { %>
          <option value="<%= s.id %>" <%= filters.sedeId === s.id ? 'selected' : '' %>>
            <%= s.nombre %> <%= s.esAldeaMunicipalizada ? '(Aldea)' : '' %>
          </option>
        <% }); %>
      </select>

      <!-- Filtro por Asignación Docente -->
      <select name="docente" class="table-filter-select" onchange="this.form.submit()">
        <option value="">Todos los estados</option>
        <option value="CON_DOCENTE" <%= filters.docente === 'CON_DOCENTE' ? 'selected' : '' %>>Con Docente</option>
        <option value="VACANTE" <%= filters.docente === 'VACANTE' ? 'selected' : '' %>>Vacantes</option>
      </select>

      <!-- Botón Limpiar Filtros -->
      <a 
        href="/periodos/<%= periodo.id %>/secciones" 
        class="btn-clean-ghost <%= (filters.q || filters.pfgId || filters.turno || filters.sedeId || filters.docente || filters.sortBy !== 'codigoSeccion') ? '' : 'uk-hidden' %>" 
        title="Restablecer filtros"
      >
        <span uk-icon="icon: refresh; ratio: 0.75"></span>
        <span>Limpiar</span>
      </a>
    </div>
  </form>

  <!-- Contenedor de Tabla con Estilos Limpios del Sistema -->
  <div id="secciones-table-container">
    <div class="uk-overflow-auto uk-margin-small-top">
      <table class="clean-table" id="secciones-table">
        <thead>
          <tr>
            <th class="<%= getSortHeaderClass('codigoSeccion') %>" style="width: 140px;">
              <a href="<%= getSortUrl('codigoSeccion') %>" class="uk-link-reset">Código Sección</a>
            </th>
            <th>Unidad Curricular</th>
            <th style="width: 180px;">PFG & Trayecto</th>
            <th class="<%= getSortHeaderClass('turno') %>" style="width: 110px;">
              <a href="<%= getSortUrl('turno') %>" class="uk-link-reset">Turno</a>
            </th>
            <th style="width: 160px;">Sede / Espacio</th>
            <th style="width: 200px;">Docente Responsable</th>
            <th class="uk-text-center <%= getSortHeaderClass('cuposEstimados') %>" style="width: 80px;">
              <a href="<%= getSortUrl('cuposEstimados') %>" class="uk-link-reset">Cupos</a>
            </th>
            <th class="table-actions-cell uk-text-right">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (secciones.length === 0) { %>
            <tr>
              <td colspan="8" class="uk-text-center uk-text-muted py-5">
                No se encontraron secciones con los filtros aplicados en este período.
              </td>
            </tr>
          <% } %>

          <% secciones.forEach(function(s) { 
            const uc = s.unidadCurricular;
            const pfg = uc.pfg;
            const horasTotales = uc.horasTeoricasSemanales + uc.horasPracticasSemanales + uc.horasCampoComunitarioSemanales;
          %>
            <tr>
              <!-- Código Sección -->
              <td>
                <span class="font-bold text-sm" style="color: var(--text-white);"><%= s.codigoSeccion %></span>
                <% if (uc.esProyectoComunitario) { %>
                  <span class="badge-role badge-admin text-xxs uk-margin-xsmall-left">Proyecto</span>
                <% } %>
              </td>

              <!-- Unidad Curricular -->
              <td>
                <div class="font-medium text-sm" style="color: var(--text-white);"><%= uc.nombre %></div>
                <div class="table-sub-info">
                  <%= uc.codigo %> &bull; <%= horasTotales %>h sem (<%= uc.horasTeoricasSemanales %>T / <%= uc.horasPracticasSemanales %>P <%= uc.horasCampoComunitarioSemanales > 0 ? '/ ' + uc.horasCampoComunitarioSemanales + 'C' : '' %>)
                </div>
              </td>

              <!-- PFG & Trayecto -->
              <td>
                <div class="text-sm font-medium" style="color: var(--text-white);"><%= pfg.nombre %></div>
                <div class="table-sub-info">Trayecto <%= uc.trayecto %>, Tramo <%= uc.tramo %></div>
              </td>

              <!-- Turno -->
              <td>
                <span class="status-pill <%= s.turno === 'MATUTINO' ? 'status-active' : (s.turno === 'VESPERTINO' ? 'indicator-blue' : 'indicator-teal') %>">
                  <%= s.turno %>
                </span>
              </td>

              <!-- Sede -->
              <td>
                <div class="text-xs font-medium" style="color: var(--text-white);"><%= s.sede.nombre %></div>
                <% if (s.sede.esAldeaMunicipalizada) { %>
                  <div class="table-sub-info">Aldea Universitaria</div>
                <% } %>
              </td>

              <!-- Docente Responsable -->
              <td>
                <% if (s.profesor) { %>
                  <div class="font-medium text-sm" style="color: var(--text-white);">
                    <%= s.profesor.nombres %> <%= s.profesor.apellidos %>
                  </div>
                  <div class="table-sub-info">
                    V-<%= s.profesor.cedula %> &bull; <%= s.profesor.escalafon %>
                  </div>
                <% } else { %>
                  <span class="status-pill status-inactive">Vacante (Sin Asignar)</span>
                <% } %>
              </td>

              <!-- Cupos -->
              <td class="uk-text-center">
                <span class="font-bold text-sm" style="color: var(--text-white);"><%= s.cuposEstimados %></span>
              </td>

              <!-- Acciones -->
              <td class="table-actions-cell uk-text-right">
                <div class="table-actions-group">
                  <button 
                    class="btn-table-action" 
                    uk-toggle="target: #modal-asignar-docente-<%= s.id %>"
                    title="Asignar o Cambiar Docente"
                  >
                    <span uk-icon="icon: user; ratio: 0.75"></span>
                    <span><%= s.profesorId ? 'Cambiar Prof.' : 'Asignar' %></span>
                  </button>

                  <form action="/periodos/<%= periodo.id %>/secciones/<%= s.id %>/eliminar" method="POST" onsubmit="return confirm('¿Eliminar la sección <%= s.codigoSeccion %>?');">
                    <button class="btn-table-action text-danger" type="submit" title="Eliminar Sección">
                      <span uk-icon="icon: trash; ratio: 0.75"></span>
                    </button>
                  </form>
                </div>

                <!-- Modal Asignar Docente -->
                <div id="modal-asignar-docente-<%= s.id %>" uk-modal>
                  <div class="uk-modal-dialog uk-modal-body modal-clean-box uk-text-left">
                    <button class="uk-modal-close-default" type="button" uk-close></button>
                    <h3 class="panel-title uk-margin-xsmall-bottom">
                      Asignación Docente: <%= s.codigoSeccion %>
                    </h3>
                    <p class="panel-subtitle uk-margin-small-bottom">
                      <%= uc.nombre %> (<%= horasTotales %>h semanales). Se evalúa automáticamente la regla H-04 para evitar sobrecarga legal.
                    </p>

                    <form action="/periodos/<%= periodo.id %>/secciones/<%= s.id %>/asignar-profesor" method="POST" class="login-form-clean">
                      <div class="form-group-clean">
                        <label class="label-clean">Seleccionar Profesor</label>
                        <select name="profesorId" class="table-filter-select" style="width: 100%; height: 38px;">
                          <option value="">-- Dejar Vacante (Sin Docente) --</option>
                          <% profesores.forEach(function(p) { 
                            const ded = p.dedicaciones[0] ? p.dedicaciones[0].dedicacion : 'SIN DEDICACIÓN';
                            const isSelected = s.profesorId === p.id;
                          %>
                            <option value="<%= p.id %>" <%= isSelected ? 'selected' : '' %>>
                              <%= p.apellidos %>, <%= p.nombres %> (V-<%= p.cedula %>) [<%= ded %>]
                            </option>
                          <% }); %>
                        </select>
                      </div>

                      <div class="uk-margin-medium-top uk-text-right uk-flex uk-flex-right gap-2">
                        <button class="btn-clean-ghost uk-modal-close" type="button">Cancelar</button>
                        <button class="btn-clean-primary" type="submit">Guardar Asignación</button>
                      </div>
                    </form>
                  </div>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Paginación de Servidor Idéntica al Estilo Institucional (Spec 07) -->
    <div class="table-footer">
      <div class="table-sub-info">
        Mostrando <strong><%= secciones.length %></strong> de <strong><%= pagination.total %></strong> secciones
      </div>

      <% if (pagination.totalPages > 1) { %>
        <ul class="clean-pagination-list">
          <li>
            <a 
              href="<%= pagination.hasPrevPage ? makeQueryUrl({ page: pagination.page - 1 }) : '#' %>" 
              class="page-nav-btn <%= !pagination.hasPrevPage ? 'is-disabled' : '' %>"
              <%= !pagination.hasPrevPage ? 'tabindex="-1" aria-disabled="true"' : '' %>
            >
              <span uk-icon="icon: chevron-left; ratio: 0.75"></span>
              <span>Anterior</span>
            </a>
          </li>

          <% for (let i = 1; i <= pagination.totalPages; i++) { %>
            <% if (i === 1 || i === pagination.totalPages || (i >= pagination.page - 1 && i <= pagination.page + 1)) { %>
              <li>
                <a 
                  href="<%= makeQueryUrl({ page: i }) %>" 
                  class="page-number-btn <%= i === pagination.page ? 'is-active' : '' %>"
                >
                  <%= i %>
                </a>
              </li>
            <% } else if (i === pagination.page - 2 || i === pagination.page + 2) { %>
              <li class="page-ellipsis">&hellip;</li>
            <% } %>
          <% } %>

          <li>
            <a 
              href="<%= pagination.hasNextPage ? makeQueryUrl({ page: pagination.page + 1 }) : '#' %>" 
              class="page-nav-btn <%= !pagination.hasNextPage ? 'is-disabled' : '' %>"
              <%= !pagination.hasNextPage ? 'tabindex="-1" aria-disabled="true"' : '' %>
            >
              <span>Siguiente</span>
              <span uk-icon="icon: chevron-right; ratio: 0.75"></span>
            </a>
          </li>
        </ul>
      <% } %>
    </div>
  </div>
</div>

<!-- Modal para Crear Nueva Sección Asistida por Malla Curricular (Spec 09) -->
<div id="modal-nueva-seccion" uk-modal>
  <div class="uk-modal-dialog uk-modal-body modal-clean-box" style="max-width: 650px;">
    <button class="uk-modal-close-default" type="button" uk-close></button>
    <h2 class="panel-title uk-margin-small-bottom">Aperturar Nueva Sección</h2>
    <p class="panel-subtitle uk-margin-bottom">
      Apertura asistida para el período <strong style="color: var(--brand-accent);"><%= periodo.codigo %></strong> con validación curricular RC-02.
    </p>

    <form action="/periodos/<%= periodo.id %>/secciones" method="POST" class="login-form-clean" id="form-crear-seccion-asistida">
      <!-- 1. Selección de PFG -->
      <div class="form-group-clean">
        <label class="label-clean">1. Programa de Formación de Grado (PFG)</label>
        <select id="seccion-select-pfg" name="pfgId" required class="table-filter-select" style="width: 100%; height: 38px;" onchange="alCambiarPfgSeccion(this.value)">
          <option value="">-- Seleccionar PFG del Estudiante --</option>
          <% pfgs.forEach(function(pfg) { %>
            <option value="<%= pfg.id %>">[<%= pfg.codigo %>] <%= pfg.nombre %></option>
          <% }); %>
        </select>
      </div>

      <!-- 2. Unidad Curricular Filtrada -->
      <div class="form-group-clean">
        <label class="label-clean">2. Unidad Curricular de la Malla</label>
        <select id="seccion-select-uc" name="unidadCurricularId" required class="table-filter-select" style="width: 100%; height: 38px;" onchange="alSeleccionarUcSeccion(this)">
          <option value="">-- Seleccione primero un PFG --</option>
        </select>
      </div>

      <!-- Info-Card Reactiva de Requerimientos Curriculares y Solver -->
      <div id="seccion-uc-infocard" class="uk-card uk-card-default uk-card-body uk-margin-small-bottom" style="display: none; background-color: var(--surface-card-hover); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 0.85rem;">
        <div class="uk-flex uk-flex-between uk-flex-middle">
          <span class="text-xs font-semibold uk-text-muted uk-text-uppercase">Parámetros Solver CP-SAT / Genético:</span>
          <span id="uc-badge-espacio" class="badge-trayecto" style="font-size: 0.72rem;">AULA_TEORICA</span>
        </div>
        <div class="uk-grid-small uk-child-width-1-3 uk-margin-xsmall-top" uk-grid>
          <div>
            <span class="text-xs uk-text-muted uk-display-block">Carga Lectiva (HT+HP):</span>
            <strong id="uc-info-horas" style="color: var(--text-white); font-size: 0.9rem;">4h / semana</strong>
          </div>
          <div>
            <span class="text-xs uk-text-muted uk-display-block">Bloques Semanales:</span>
            <strong id="uc-info-bloques" style="color: var(--brand-accent); font-size: 0.9rem;">2 de 90 min</strong>
          </div>
          <div>
            <span class="text-xs uk-text-muted uk-display-block">Ubicación Malla:</span>
            <span id="uc-info-ubicacion" style="color: var(--text-muted); font-size: 0.85rem;">T1 - M1</span>
          </div>
        </div>
      </div>

      <div class="uk-grid-small uk-child-width-1-2" uk-grid>
        <div>
          <div class="form-group-clean">
            <label class="label-clean">3. Código de Sección (Sugerido)</label>
            <input type="text" id="seccion-codigo-input" name="codigoSeccion" required placeholder="SEC-<%= periodo.codigo %>-UC-M-01" class="input-control-clean" style="padding-left: 0.75rem;">
          </div>
        </div>
        <div>
          <div class="form-group-clean">
            <label class="label-clean">Cupos Estimados</label>
            <input type="number" name="cuposEstimados" required value="30" min="5" max="100" class="input-control-clean" style="padding-left: 0.75rem;">
          </div>
        </div>
      </div>

      <div class="uk-grid-small uk-child-width-1-2" uk-grid>
        <div>
          <div class="form-group-clean">
            <label class="label-clean">Sede / Aldea</label>
            <select name="sedeId" required class="table-filter-select" style="width: 100%; height: 38px;">
              <% sedes.forEach(function(sede) { %>
                <option value="<%= sede.id %>"><%= sede.nombre %></option>
              <% }); %>
            </select>
          </div>
        </div>
        <div>
          <div class="form-group-clean">
            <label class="label-clean">Turno de Dictado</label>
            <select id="seccion-select-turno" name="turno" required class="table-filter-select" style="width: 100%; height: 38px;" onchange="actualizarCodigoSugerido()">
              <% turnos.forEach(function(t) { %>
                <option value="<%= t %>"><%= t %></option>
              <% }); %>
            </select>
          </div>
        </div>
      </div>

      <div class="form-group-clean">
        <label class="label-clean">Docente Asignado (Opcional)</label>
        <select name="profesorId" class="table-filter-select" style="width: 100%; height: 38px;">
          <option value="">-- Dejar Vacante para Asignación Posterior / Solver --</option>
          <% profesores.forEach(function(p) { 
            const ded = p.dedicaciones[0] ? p.dedicaciones[0].dedicacion : 'SIN DEDICACIÓN';
          %>
            <option value="<%= p.id %>"><%= p.apellidos %>, <%= p.nombres %> (V-<%= p.cedula %>) [<%= ded %>]</option>
          <% }); %>
        </select>
      </div>

      <div class="uk-margin-medium-top uk-text-right uk-flex uk-flex-right gap-2">
        <button class="btn-clean-secondary uk-modal-close" type="button">
          <span>Cancelar</span>
        </button>
        <button class="btn-clean-primary" type="submit">
          <span uk-icon="icon: check; ratio: 0.8"></span>
          <span>Aperturar Sección</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  let ucsActualesPfg = [];
  const periodoCodigoActual = '<%= periodo.codigo %>';

  async function alCambiarPfgSeccion(pfgId) {
    const selectUc = document.getElementById('seccion-select-uc');
    const infoCard = document.getElementById('seccion-uc-infocard');
    selectUc.innerHTML = '<option value="">-- Cargando unidades de la malla... --</option>';
    infoCard.style.display = 'none';

    if (!pfgId) {
      selectUc.innerHTML = '<option value="">-- Seleccione primero un PFG --</option>';
      return;
    }

    try {
      const resp = await fetch('/curriculo/api/pfg/' + encodeURIComponent(pfgId) + '/unidades');
      const data = await resp.json();
      if (data.ok && Array.isArray(data.unidades)) {
        ucsActualesPfg = data.unidades;
        if (ucsActualesPfg.length === 0) {
          selectUc.innerHTML = '<option value="">-- No hay UCs registradas para este PFG --</option>';
        } else {
          selectUc.innerHTML = '<option value="">-- Seleccionar Unidad Curricular --</option>' +
            ucsActualesPfg.map(u => 
              `<option value="${u.id}" data-codigo="${u.codigo}" data-ht="${u.horasTeoricas}" data-hp="${u.horasPracticas}" data-bloques="${u.bloques90Min}" data-espacio="${u.tipoEspacioRequerido}" data-trayecto="${u.trayecto}" data-tramo="${u.tramo}">
                T${u.trayecto}-M${u.tramo} | ${u.codigo} - ${u.nombre} (${u.horasLectivas}h lectivas)
              </option>`
            ).join('');
        }
      } else {
        selectUc.innerHTML = '<option value="">-- Error al cargar catálogo --</option>';
      }
    } catch (err) {
      console.error('Error fetching UCs:', err);
      selectUc.innerHTML = '<option value="">-- Error al consultar servidor --</option>';
    }
  }

  function alSeleccionarUcSeccion(selectElem) {
    const selectedOpt = selectElem.options[selectElem.selectedIndex];
    const infoCard = document.getElementById('seccion-uc-infocard');

    if (!selectedOpt || !selectedOpt.value) {
      infoCard.style.display = 'none';
      return;
    }

    const codigo = selectedOpt.getAttribute('data-codigo') || 'UC';
    const ht = parseInt(selectedOpt.getAttribute('data-ht') || '0', 10);
    const hp = parseInt(selectedOpt.getAttribute('data-hp') || '0', 10);
    const bloques = parseInt(selectedOpt.getAttribute('data-bloques') || '0', 10);
    const espacio = selectedOpt.getAttribute('data-espacio') || 'AULA_TEORICA';
    const trayecto = selectedOpt.getAttribute('data-trayecto') || '1';
    const tramo = selectedOpt.getAttribute('data-tramo') || '1';

    document.getElementById('uc-badge-espacio').textContent = espacio.replace(/_/g, ' ');
    document.getElementById('uc-info-horas').textContent = (ht + hp) + 'h / semana (HT:' + ht + ' HP:' + hp + ')';
    document.getElementById('uc-info-bloques').textContent = bloques + ' Bloques de 90 min';
    document.getElementById('uc-info-ubicacion').textContent = 'Trayecto ' + trayecto + ' - Tramo ' + tramo;

    infoCard.style.display = 'block';

    actualizarCodigoSugerido(codigo);
  }

  function actualizarCodigoSugerido(codigoUcParam) {
    const selectUc = document.getElementById('seccion-select-uc');
    const selectedOpt = selectUc.options[selectUc.selectedIndex];
    const ucCodigo = codigoUcParam || (selectedOpt ? selectedOpt.getAttribute('data-codigo') : null);
    if (!ucCodigo) return;

    const turno = document.getElementById('seccion-select-turno').value || 'MATUTINO';
    const inicialTurno = turno.charAt(0).toUpperCase();
    const codigoInput = document.getElementById('seccion-codigo-input');
    codigoInput.value = `SEC-${periodoCodigoActual}-${ucCodigo}-${inicialTurno}-01`;
  }
</script>

<!-- Modal Solver de Optimización Automática -->
<%- include('../../partials/modal-solver', { periodoId: periodo.id, periodoCodigo: periodo.codigo }) %>

