      <div class="uk-grid-small uk-child-width-1-2" uk-grid>
        <div>
          <div class="form-group-clean">
            <label class="label-clean">Sede / Aldea</label>
            <select name="sedeId" required class="table-filter-select form-select-full">
              <% sedes.forEach(function(sede) { %>
                <option value="<%= sede.id %>"><%= sede.nombre %></option>
              <% }); %>
            </select>
          </div>
        </div>
        <div>
          <div class="form-group-clean">
            <label class="label-clean">Eje Municipal</label>
            <select name="ejeMunicipal" class="table-filter-select form-select-full">
              <option value="">No indicado</option>
              <% ['RÍO CAURA', 'RÍO CARONÍ', 'SIERRA IMATACA', 'INDIO PEMÓN', 'FAJA DEL ORINOCO'].forEach(function(eje) { %>
                <option value="<%= eje %>"><%= eje %></option>
