        <div>
          <div class="form-group-clean">
            <label class="label-clean">Malla</label>
            <select name="malla" class="table-filter-select form-select-full">
              <option value="">No indicada</option>
              <% mallas.forEach(function(m) { %>
                <option value="<%= m %>"><%= m %></option>
              <% }); %>
