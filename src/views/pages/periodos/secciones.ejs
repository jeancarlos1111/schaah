<script>
  let ucsActualesPfg = [];
  const periodoCodigoActual = '<%= periodo.codigo %>';

  function alSeleccionarGrupo(selectElem) {
    const opcion = selectElem.options[selectElem.selectedIndex];
    const pfgId = opcion ? opcion.getAttribute('data-pfg') : null;
    if (!pfgId) return;
    const selectPfg = document.getElementById('seccion-select-pfg');
    if (selectPfg.value !== pfgId) {
      selectPfg.value = pfgId;
      alCambiarPfgSeccion(pfgId);
    }
    actualizarCodigoSugerido();
  }

  async function alCambiarPfgSeccion(pfgId) {
    const selectUc = document.getElementById('seccion-select-uc');
    const infoCard = document.getElementById('seccion-uc-infocard');
    selectUc.innerHTML = '<option value="">-- Cargando unidades de la malla... --</option>';
    infoCard.style.display = 'none';

    if (!pfgId) {
      selectUc.innerHTML = '<option value="">-- Seleccione primero un PFG --</option>';
      return;
    }

    try {
      const resp = await fetch('/curriculo/api/pfg/' + encodeURIComponent(pfgId) + '/unidades');
      const data = await resp.json();
      if (data.ok && Array.isArray(data.unidades)) {
        ucsActualesPfg = data.unidades;
        if (ucsActualesPfg.length === 0) {
          selectUc.innerHTML = '<option value="">-- No hay UCs registradas para este PFG --</option>';
        } else {
          selectUc.innerHTML = '<option value="">-- Seleccionar Unidad Curricular --</option>' +
            ucsActualesPfg.map(u => 
              `<option value="${u.id}" data-codigo="${u.codigo}" data-ht="${u.horasTeoricas}" data-hp="${u.horasPracticas}" data-bloques="${u.bloques90Min}" data-espacio="${u.tipoEspacioRequerido}" data-trayecto="${u.trayecto}" data-tramo="${u.tramo}">
                ${u.trayecto === null || u.tramo === null ? 'Sin trayecto' : 'T' + u.trayecto + '-M' + u.tramo} | ${u.codigo} - ${u.nombre} (${u.horasLectivas}h lectivas)
              </option>`
            ).join('');
        }
      } else {
        selectUc.innerHTML = '<option value="">-- Error al cargar catálogo --</option>';
      }
    } catch (err) {
      console.error('Error fetching UCs:', err);
      selectUc.innerHTML = '<option value="">-- Error al consultar servidor --</option>';
    }
  }

  function alSeleccionarUcSeccion(selectElem) {
    const selectedOpt = selectElem.options[selectElem.selectedIndex];
    const infoCard = document.getElementById('seccion-uc-infocard');

    if (!selectedOpt || !selectedOpt.value) {
      infoCard.style.display = 'none';
      return;
    }

    const codigo = selectedOpt.getAttribute('data-codigo') || 'UC';
    const ht = parseInt(selectedOpt.getAttribute('data-ht') || '0', 10);
    const hp = parseInt(selectedOpt.getAttribute('data-hp') || '0', 10);
    const bloques = parseInt(selectedOpt.getAttribute('data-bloques') || '0', 10);
    const espacio = selectedOpt.getAttribute('data-espacio') || 'AULA_TEORICA';
    const trayecto = selectedOpt.getAttribute('data-trayecto') || '1';
    const tramo = selectedOpt.getAttribute('data-tramo') || '1';

    document.getElementById('uc-badge-espacio').textContent = espacio.replace(/_/g, ' ');
    document.getElementById('uc-info-horas').textContent = (ht + hp) + 'h / semana (HT:' + ht + ' HP:' + hp + ')';
    document.getElementById('uc-info-bloques').textContent = bloques + ' Bloques de 90 min';
    document.getElementById('uc-info-ubicacion').textContent = (trayecto === 'null' || tramo === 'null')
      ? 'Sin malla por trayectos'
      : 'Trayecto ' + trayecto + ' - Tramo ' + tramo;

    infoCard.style.display = 'block';

    actualizarCodigoSugerido(codigo);
  }

  function actualizarCodigoSugerido(codigoUcParam) {
    const selectUc = document.getElementById('seccion-select-uc');
    const selectedOpt = selectUc.options[selectUc.selectedIndex];
    const ucCodigo = codigoUcParam || (selectedOpt ? selectedOpt.getAttribute('data-codigo') : null);
    if (!ucCodigo) return;

    const codigoInput = document.getElementById('seccion-codigo-input');
    const selectGrupo = document.getElementById('seccion-select-grupo');
    const grupoOpt = selectGrupo.options[selectGrupo.selectedIndex];
    const grupoCodigo = grupoOpt ? grupoOpt.getAttribute('data-codigo') : null;
    if (grupoCodigo) {
      codigoInput.value = `${grupoCodigo}-${ucCodigo}`;
      return;
    }
    const turno = document.getElementById('seccion-select-turno').value || 'MATUTINO';
    const inicialTurno = turno.charAt(0).toUpperCase();
    codigoInput.value = `SEC-${periodoCodigoActual}-${ucCodigo}-${inicialTurno}-01`;
  }
</script>

<script>
  (function () {
    const MAX_VISIBLES = 60;
    const ETIQUETA_DEDICACION = {
      DEDICACION_EXCLUSIVA: 'Exclusiva',
      TIEMPO_COMPLETO: 'Tiempo completo',
      MEDIO_TIEMPO: 'Medio tiempo',
      TIEMPO_CONVENCIONAL: 'Convencional',
    };
    const normalizar = (t) => (t || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const docentes = JSON.parse(document.getElementById('docentes-carga-data').textContent);
    docentes.forEach((d) => {
      d.busqueda = normalizar(`${d.nombre} ${d.cedula} ${d.cedula.replace(/\D/g, '')}`);
    });

    const form = document.getElementById('form-asignar-docente');
    const lista = document.getElementById('asig-lista');
    const buscar = document.getElementById('asig-buscar');
    const toggle = document.getElementById('asig-solo-disponibles');
    const contador = document.getElementById('asig-contador');
    const resumen = document.getElementById('asig-resumen');
    const guardar = document.getElementById('asig-guardar');
    const inputProfesor = document.getElementById('asig-profesor-id');

    let fila = null;
    let seleccionado = '';
    let soloDisponibles = false;

    function proyectadas(d) {
      return d.id === fila.profesorId ? d.horas : d.horas + fila.horas;
    }

    function excede(d) {
      return d.dedicacion !== null && proyectadas(d) > d.maxHoras;
    }

    function elemento(tag, clase, texto) {
      const el = document.createElement(tag);
      if (clase) el.className = clase;
      if (texto !== undefined) el.textContent = texto;
      return el;
    }

    function chipEstado(d) {
      if (d.dedicacion === null) return elemento('span', 'oferta-chip oferta-chip-muted', 'Sin dedicación en el período');
      const total = proyectadas(d);
      if (total > d.maxHoras) return elemento('span', 'oferta-chip oferta-chip-danger', `Quedaría en ${total} h (excede ${d.maxHoras} h)`);
      if (total < d.minHoras) return elemento('span', 'oferta-chip oferta-chip-warning', `Quedaría en ${total} h (mínimo ${d.minHoras} h)`);
      return elemento('span', 'oferta-chip oferta-chip-ok', `Quedaría en ${total} h`);
    }

    function itemDocente(d) {
      const item = elemento('button', 'docente-picker-item');
      item.type = 'button';
      item.setAttribute('role', 'option');
      item.setAttribute('aria-selected', String(seleccionado === d.id));
      item.dataset.id = d.id;

      const info = elemento('div', 'docente-picker-info');
      info.appendChild(elemento('span', 'docente-picker-name', d.nombre));
      const ded = d.dedicacion ? ETIQUETA_DEDICACION[d.dedicacion] || d.dedicacion : 'Sin dedicación';
      const actual = d.id === fila.profesorId ? ' • Docente actual' : '';
      info.appendChild(elemento('span', 'table-sub-info', `${d.cedula} • ${ded}${actual}`));

      const carga = elemento('div', 'docente-picker-load');
      carga.appendChild(elemento('span', 'docente-picker-hours', `${d.horas}/${d.maxHoras} h`));
      const barra = elemento('div', 'docente-picker-bar');
      const relleno = elemento('span', d.horas > d.maxHoras ? 'is-over' : '');
      relleno.style.width = `${Math.min(100, Math.round((d.horas / Math.max(d.maxHoras, 1)) * 100))}%`;
      barra.appendChild(relleno);
      carga.appendChild(barra);
      carga.appendChild(chipEstado(d));

      item.appendChild(info);
      item.appendChild(carga);
      return item;
    }

    function itemVacante() {
      const item = elemento('button', 'docente-picker-item docente-picker-item-vacante');
      item.type = 'button';
      item.setAttribute('role', 'option');
      item.setAttribute('aria-selected', String(seleccionado === ''));
      item.dataset.id = '';
      const info = elemento('div', 'docente-picker-info');
      info.appendChild(elemento('span', 'docente-picker-name', 'Dejar vacante (sin docente)'));
      info.appendChild(elemento('span', 'table-sub-info', 'La asignación queda como POR ASIGNAR en la oferta'));
      item.appendChild(info);
      return item;
    }

    function ordenar(a, b) {
      if (a.id === fila.profesorId) return -1;
      if (b.id === fila.profesorId) return 1;
      const rango = (d) => (d.dedicacion === null ? 1 : excede(d) ? 2 : 0);
      return rango(a) - rango(b) || a.nombre.localeCompare(b.nombre, 'es');
    }

    function render() {
      const termino = normalizar(buscar.value.trim());
      const coinciden = docentes
        .filter((d) => !termino || d.busqueda.includes(termino))
        .filter((d) => !soloDisponibles || (d.dedicacion !== null && !excede(d)))
        .sort(ordenar);

      lista.replaceChildren();
      if (!termino && !soloDisponibles) lista.appendChild(itemVacante());
      coinciden.slice(0, MAX_VISIBLES).forEach((d) => lista.appendChild(itemDocente(d)));
      if (coinciden.length === 0) lista.appendChild(elemento('div', 'docente-picker-empty', 'Ningún docente coincide con la búsqueda.'));

      contador.textContent =
        coinciden.length > MAX_VISIBLES
          ? `Mostrando ${MAX_VISIBLES} de ${coinciden.length} docentes. Escriba para acotar la búsqueda.`
          : `${coinciden.length} docente(s)`;
      actualizarResumen();
    }

    function actualizarResumen() {
      inputProfesor.value = seleccionado;
      resumen.replaceChildren();
      resumen.className = 'docente-picker-summary';
      guardar.disabled = false;
      if (!seleccionado) {
        resumen.textContent = 'La asignación quedará vacante.';
        return;
      }
      const d = docentes.find((x) => x.id === seleccionado);
      if (!d) return;
      const total = proyectadas(d);
      if (excede(d)) {
        resumen.classList.add('is-danger');
        resumen.textContent = `${d.nombre} quedaría con ${total} h y su tope es ${d.maxHoras} h: el sistema rechaza la asignación por la regla H-04.`;
        guardar.disabled = true;
      } else if (d.dedicacion === null) {
        resumen.classList.add('is-warning');
        resumen.textContent = `${d.nombre} no tiene dedicación registrada en el período; no se puede verificar el tope H-04.`;
      } else {
        resumen.textContent = `${d.nombre} quedaría con ${total} h de ${d.minHoras}–${d.maxHoras} h permitidas.`;
      }
    }

    lista.addEventListener('click', (e) => {
      const item = e.target.closest('.docente-picker-item');
      if (!item) return;
      seleccionado = item.dataset.id;
      lista.querySelectorAll('.docente-picker-item').forEach((el) => {
        el.setAttribute('aria-selected', String(el.dataset.id === seleccionado));
      });
      actualizarResumen();
    });

    buscar.addEventListener('input', render);
    buscar.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') e.preventDefault();
    });

    toggle.addEventListener('click', () => {
      soloDisponibles = !soloDisponibles;
      toggle.setAttribute('aria-pressed', String(soloDisponibles));
      render();
    });

    document.addEventListener('click', (e) => {
      const boton = e.target.closest('[data-asignar-docente]');
      if (!boton) return;
      fila = {
        seccionId: boton.dataset.seccionId,
        horas: parseInt(boton.dataset.horas, 10) || 0,
        profesorId: boton.dataset.profesorId || '',
      };
      seleccionado = fila.profesorId;
      form.action = `/periodos/<%= periodo.id %>/secciones/${fila.seccionId}/asignar-profesor`;
      document.getElementById('asig-codigo').textContent = boton.dataset.codigo;
      document.getElementById('asig-unidad').textContent = boton.dataset.unidad;
      document.getElementById('asig-horas').textContent = fila.horas;
      buscar.value = '';
      render();
      UIkit.modal('#modal-asignar-docente').show();
    });

    UIkit.util.on('#modal-asignar-docente', 'shown', () => buscar.focus());
  })();
</script>

<!-- Modal Solver de Optimización Automática -->
<%- include('../../partials/modal-solver', { periodoId: periodo.id, periodoCodigo: periodo.codigo }) %>

