        <div>
          <div class="form-group-clean">
            <label class="label-clean">Programa</label>
            <select name="pfgId" required class="table-filter-select form-select-full">
              <option value="">-- Seleccionar programa --</option>
              <% pfgs.forEach(function(pfg) { %>
                <option value="<%= pfg.id %>">[<%= pfg.codigo %>] <%= pfg.nombre %></option>
              <% }); %>
            </select>
          </div>
