        </div>
        <div>
          <div class="form-group-clean">
            <label class="label-clean">Estatus</label>
            <select name="estatus" class="table-filter-select form-select-full">
              <option value="">No indicado</option>
              <% estatusGrupo.forEach(function(e) { %>
                <option value="<%= e %>"><%= e %></option>
              <% }); %>
            </select>
          </div>
        </div>
