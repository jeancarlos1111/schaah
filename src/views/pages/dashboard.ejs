<!-- Dashboard Header / Control Bar -->
<div class="page-header uk-margin-medium-bottom">
  <div class="uk-flex uk-flex-between uk-flex-middle uk-flex-wrap">
    <div>
      <div class="header-breadcrumbs uk-margin-xsmall-bottom">
        <span>Planificación Académica</span>
        <span class="breadcrumb-separator">/</span>
        <span class="active-crumb"><%= periodo ? periodo.nombre : 'Sin período abierto' %></span>
      </div>
      <h1 class="page-title uk-margin-remove">Tablero de Control Académico</h1>
      <p class="page-subtitle uk-margin-xsmall-top">
        Monitoreo de carga horaria, disponibilidad profesoral y uso de espacios físicos.
      </p>
    </div>
    <div class="header-controls uk-margin-small-top">
      <button class="btn-clean-secondary" onclick="location.reload()">
        <span uk-icon="icon: refresh; ratio: 0.8" class="uk-margin-xsmall-right"></span> Actualizar
      </button>
      <a href="/horarios" class="btn-clean-primary uk-margin-small-left">
        <span uk-icon="icon: grid; ratio: 0.85" class="uk-margin-xsmall-right"></span> <%= esDocente ? 'Mi Horario' : 'Matriz de Horarios' %>
      </a>
    </div>
  </div>
</div>

<!-- Grid de Métricas Principales (Enterprise Bento Clean) -->
<div class="uk-grid-match uk-grid-medium uk-child-width-1-2@s uk-child-width-1-4@l uk-margin-medium-bottom" uk-grid>
  
  <!-- Métrica: Profesores -->
  <div>
    <div class="clean-stat-card">
      <div class="stat-top-row">
        <span class="stat-category">Personal Docente</span>
        <span class="stat-indicator indicator-blue">Activos</span>
      </div>
      <div class="stat-value-row">
        <span class="stat-number"><%= metricas.docentesTotales %></span>
        <span class="stat-unit">docentes</span>
      </div>
      <div class="stat-detail-row">
        <span class="detail-highlight"><%= metricas.docentesExclusivos %></span>
        <span class="detail-label">en Dedicación Exclusiva (DE)</span>
      </div>
    </div>
  </div>

  <!-- Métrica: Secciones -->
  <div>
    <div class="clean-stat-card">
      <div class="stat-top-row">
        <span class="stat-category">Oferta de Secciones</span>
        <span class="stat-indicator indicator-teal"><%= metricas.porcentajeAsignado %>% Asignado</span>
      </div>
      <div class="stat-value-row">
        <span class="stat-number"><%= metricas.seccionesTotales %></span>
        <span class="stat-unit">secciones</span>
      </div>
      <!-- Barra de progreso precisa y limpia -->
      <div class="clean-progress-track">
        <div class="clean-progress-fill" style="width: <%= metricas.porcentajeAsignado %>%;"></div>
      </div>
      <div class="stat-detail-row uk-margin-xsmall-top">
        <span class="detail-highlight"><%= metricas.seccionesAsignadas %></span>
        <span class="detail-label">de <%= metricas.seccionesTotales %> con docente asignado</span>
      </div>
    </div>
  </div>

  <!-- Métrica: Espacios Físicos -->
  <div>
    <div class="clean-stat-card">
      <div class="stat-top-row">
        <span class="stat-category">Espacios Académicos</span>
        <span class="stat-indicator indicator-gray"><%= metricas.sedesActivas %> Sedes</span>
      </div>
      <div class="stat-value-row">
        <span class="stat-number"><%= metricas.espaciosTotales %></span>
        <span class="stat-unit">aulas / labs</span>
      </div>
      <div class="stat-detail-row">
        <span class="detail-highlight">100%</span>
        <span class="detail-label">Capacidad de aforo catalogada</span>
      </div>
    </div>
  </div>

  <!-- Métrica: Conformidad Normativa -->
  <div>
    <div class="clean-stat-card <%= metricas.alertasSobrecarga > 0 ? 'card-warning' : '' %>">
      <div class="stat-top-row">
        <span class="stat-category">Cumplimiento Legal</span>
        <span class="stat-indicator <%= metricas.alertasSobrecarga === 0 ? 'indicator-green' : 'indicator-red' %>">
          <%= metricas.alertasSobrecarga === 0 ? 'Conforme' : 'Alerta' %>
        </span>
      </div>
      <div class="stat-value-row">
        <span class="stat-number <%= metricas.alertasSobrecarga === 0 ? 'text-green' : 'text-red' %>">
          <%= metricas.alertasSobrecarga %>
        </span>
        <span class="stat-unit">desviaciones</span>
      </div>
      <div class="stat-detail-row">
        <span class="detail-label">
          <% if (metricas.alertasSobrecarga === 0) { %>
            Cero sobrecargas ni déficits de carga (H-04 y H-05)
          <% } else { %>
            <%= metricas.sobrecargas %> sobrecargas (H-04) y <%= metricas.deficits %> déficits (H-05) de carga docente
          <% } %>
        </span>
      </div>
    </div>
  </div>

</div>

<!-- Sección de Módulos Operativos (Clean Bento Tiles) -->
<div class="clean-panel uk-margin-medium-bottom">
  <div class="clean-panel-header">
    <div>
      <h2 class="panel-title uk-margin-remove">Módulos del Sistema</h2>
      <p class="panel-subtitle uk-margin-remove">Acceso directo a los procesos de planificación y auditoría</p>
    </div>
  </div>

  <div class="uk-grid-small uk-child-width-1-2@s uk-child-width-1-4@m uk-margin-top" uk-grid>
    
    <div>
      <a href="/horarios" class="clean-tile">
        <div class="tile-bar-accent accent-teal"></div>
        <div class="tile-icon-box">
          <span uk-icon="icon: table; ratio: 1.1"></span>
        </div>
        <div class="tile-text">
          <h3 class="tile-title"><%= esDocente ? 'Mi Horario' : 'Matriz de Horarios' %></h3>
          <p class="tile-description">
            <%= esDocente ? 'Consulta de su horario semanal y descarga en PDF.' : 'Edición por profesor, aula o sección con validación instantánea.' %>
          </p>
        </div>
        <div class="tile-action">
          <span class="tile-link-text"><%= esDocente ? 'Ver mi horario' : 'Abrir matriz' %></span>
          <span uk-icon="icon: arrow-right; ratio: 0.85"></span>
        </div>
      </a>
    </div>

    <div>
      <a href="<%= esDocente ? '/mi-disponibilidad' : '/docentes' %>" class="clean-tile">
        <div class="tile-bar-accent accent-blue"></div>
        <div class="tile-icon-box">
          <span uk-icon="icon: calendar; ratio: 1.1"></span>
        </div>
        <div class="tile-text">
          <h3 class="tile-title"><%= esDocente ? 'Mi Disponibilidad' : 'Disponibilidad Docente' %></h3>
          <p class="tile-description">Registro de franjas horarias y prioridades de dedicación.</p>
        </div>
        <div class="tile-action">
          <span class="tile-link-text"><%= esDocente ? 'Declarar disponibilidad' : 'Ver docentes' %></span>
          <span uk-icon="icon: arrow-right; ratio: 0.85"></span>
        </div>
      </a>
    </div>

    <% if (!esDocente) { %>
    <div>
      <a href="/espacios" class="clean-tile">
        <div class="tile-bar-accent accent-purple"></div>
        <div class="tile-icon-box">
          <span uk-icon="icon: location; ratio: 1.1"></span>
        </div>
        <div class="tile-text">
          <h3 class="tile-title">Infraestructura</h3>
          <p class="tile-description">Catálogo de sedes, aldeas universitarias y laboratorios técnicos.</p>
        </div>
        <div class="tile-action">
          <span class="tile-link-text">Gestionar aulas</span>
          <span uk-icon="icon: arrow-right; ratio: 0.85"></span>
        </div>
      </a>
    </div>
    <% } %>

    <div>
      <a href="/reportes" class="clean-tile">
        <div class="tile-bar-accent accent-amber"></div>
        <div class="tile-icon-box">
          <span uk-icon="icon: file-text; ratio: 1.1"></span>
        </div>
        <div class="tile-text">
          <h3 class="tile-title">Normativa y Reportes</h3>
          <p class="tile-description">Reglas de horarios, límites de dedicación y planillas oficiales del período.</p>
        </div>
        <div class="tile-action">
          <span class="tile-link-text">Consultar normativa</span>
          <span uk-icon="icon: arrow-right; ratio: 0.85"></span>
        </div>
      </a>
    </div>

  </div>
</div>
