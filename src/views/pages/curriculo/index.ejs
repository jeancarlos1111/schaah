                  <a 
                    href="<%= makeQueryUrl({ page: p }) %>"
                    class="page-number-btn <%= p === pagination.page ? 'is-active' : '' %>"
                    hx-get="<%= makeQueryUrl({ page: p }) %>"
                    hx-target="#curriculo-table-container"
                    hx-select="#curriculo-table-container"
                    hx-swap="outerHTML"
                    hx-push-url="true"
                  >
                    <%= p %>
                  </a>
                </li>
              <% } %>

              <li>
                <% if (pagination.hasNext) { %>
                  <a 
                    href="<%= makeQueryUrl({ page: pagination.page + 1 }) %>"
