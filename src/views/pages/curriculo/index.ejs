<!-- Script Reactivo para Cálculos de Horas y Modales -->
<script>
  function actualizarEstimacionSolver(prefix) {
    const ht = parseInt(document.getElementById(prefix + '-ht').value, 10) || 0;
    const hp = parseInt(document.getElementById(prefix + '-hp').value, 10) || 0;
    const horasAula = ht + hp;
    const bloques = Math.floor(horasAula / 2);
    const remanente = horasAula % 2;

    const lblAula = document.getElementById(prefix + '-calc-aula');
    const lblBloques = document.getElementById(prefix + '-calc-bloques');

    if (lblAula) lblAula.textContent = horasAula + 'h';
    if (lblBloques) {
      lblBloques.textContent = bloques + ' Bloques de 90m' + (remanente > 0 ? ` (+${remanente}h)` : '');
    }
  }

  function toggleProyectoModal(prefix) {
    const check = document.getElementById(prefix + '-esProyecto');
    const selectEspacio = document.getElementById(prefix + '-tipoEspacio');
    if (check && selectEspacio) {
      if (check.checked) {
        selectEspacio.value = 'ESPACIO_COMUNITARIO_CAMPO';
      }
    }
  }

  function abrirModalEditarUnidad(uc) {
    const form = document.getElementById('form-editar-uc');
    form.action = '/curriculo/unidades/' + uc.id + '/editar';

    document.getElementById('edit-codigo').value = uc.codigo;
    document.getElementById('edit-nombre').value = uc.nombre;
    document.getElementById('edit-trayecto').value = uc.trayecto;
    sincronizarTramosPorTrayecto('edit', uc.tramo);
    document.getElementById('edit-creditos').value = uc.creditos;
    document.getElementById('edit-ht').value = uc.horasTeoricasSemanales;
    document.getElementById('edit-hp').value = uc.horasPracticasSemanales;
    document.getElementById('edit-hc').value = uc.horasCampoComunitarioSemanales;
    document.getElementById('edit-tipoEspacio').value = uc.tipoEspacioRequerido;
    document.getElementById('edit-esProyecto').checked = Boolean(uc.esProyectoComunitario);

    actualizarEstimacionSolver('edit');
    UIkit.modal('#modal-editar-unidad').show();
  }

  const MAPA_TRAYECTO_TRAMOS = {
    0: [{ val: 1, label: 'Tramo 1 (PIU / Inicial)' }],
    1: [{ val: 1, label: 'Tramo 1 (Trayecto I)' }, { val: 2, label: 'Tramo 2 (Trayecto I)' }],
    2: [{ val: 3, label: 'Tramo 3 (Trayecto II)' }, { val: 4, label: 'Tramo 4 (Trayecto II)' }],
    3: [{ val: 5, label: 'Tramo 5 (Trayecto III)' }, { val: 6, label: 'Tramo 6 (Trayecto III)' }],
    4: [{ val: 7, label: 'Tramo 7 (Trayecto IV)' }, { val: 8, label: 'Tramo 8 (Trayecto IV)' }]
  };

  function sincronizarTramosPorTrayecto(prefix, tramoSeleccionado) {
    const selTrayecto = document.getElementById(prefix + '-trayecto');
    const selTramo = document.getElementById(prefix + '-tramo');
    if (!selTrayecto || !selTramo) return;

    const trayecto = parseInt(selTrayecto.value, 10);
    const opciones = MAPA_TRAYECTO_TRAMOS[trayecto] || [];

    selTramo.innerHTML = '';
    opciones.forEach(opt => {
      const el = document.createElement('option');
      el.value = opt.val;
      el.textContent = opt.label;
      selTramo.appendChild(el);
    });

    if (tramoSeleccionado !== undefined && opciones.some(o => o.val === parseInt(tramoSeleccionado, 10))) {
      selTramo.value = tramoSeleccionado;
    } else if (opciones.length > 0) {
      selTramo.value = opciones[0].val;
    }
  }

  function sincronizarTrayectoPorTramo(prefix) {
    const selTrayecto = document.getElementById(prefix + '-trayecto');
    const selTramo = document.getElementById(prefix + '-tramo');
    if (!selTrayecto || !selTramo) return;

    const tramo = parseInt(selTramo.value, 10);
    let trayecto = 1;
    if (tramo <= 2) trayecto = 1;
    else if (tramo <= 4) trayecto = 2;
    else if (tramo <= 6) trayecto = 3;
    else if (tramo <= 8) trayecto = 4;

    if (parseInt(selTrayecto.value, 10) !== trayecto) {
      selTrayecto.value = trayecto;
      sincronizarTramosPorTrayecto(prefix, tramo);
    }
  }

  // Inicializar select de modal nuevo
  document.addEventListener('DOMContentLoaded', function() {
    sincronizarTramosPorTrayecto('nuevo');
  });
</script>
