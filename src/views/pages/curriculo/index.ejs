<!-- Script Reactivo para Cálculos de Horas y Modales -->
<script>
  function actualizarEstimacionSolver(prefix) {
    const ht = parseInt(document.getElementById(prefix + '-ht').value, 10) || 0;
    const hp = parseInt(document.getElementById(prefix + '-hp').value, 10) || 0;
    const horasAula = ht + hp;
    const bloques = Math.floor(horasAula / 2);
    const remanente = horasAula % 2;

    const lblAula = document.getElementById(prefix + '-calc-aula');
    const lblBloques = document.getElementById(prefix + '-calc-bloques');

    if (lblAula) lblAula.textContent = horasAula + 'h';
    if (lblBloques) {
      lblBloques.textContent = bloques + ' Bloques de 90m' + (remanente > 0 ? ` (+${remanente}h)` : '');
    }
  }

  function toggleProyectoModal(prefix) {
    const check = document.getElementById(prefix + '-esProyecto');
    const selectEspacio = document.getElementById(prefix + '-tipoEspacio');
    if (check && selectEspacio) {
      if (check.checked) {
        selectEspacio.value = 'ESPACIO_COMUNITARIO_CAMPO';
      }
    }
  }

  const REQUIERE_TRAYECTO = <%- JSON.stringify(Boolean(requiereTrayecto)) %>;
  const ROMANOS_TRAYECTO = ['Inicial', 'I', 'II', 'III', 'IV', 'V'];
  const CATALOGO_PRELACIONES = JSON.parse(
    (document.getElementById('catalogo-prelaciones-data') || {}).textContent || '[]'
  );
  const prelacionesSeleccionadas = { nuevo: new Set(), edit: new Set() };
  const unidadEnEdicion = { nuevo: null, edit: null };

  // RC-06: Trayecto T admite los tramos correlativos 2T-1 y 2T; el Trayecto Inicial admite 0 y 1.
  function tramosDeTrayecto(trayecto) {
    if (trayecto === 0) return [0, 1];
    if (trayecto >= 1 && trayecto <= 5) return [2 * trayecto - 1, 2 * trayecto];
    return [];
  }

  function trayectoDeTramo(tramo) {
    if (tramo === 0) return 0;
    return tramo >= 1 && tramo <= 10 ? Math.ceil(tramo / 2) : null;
  }

  function enteroONulo(valor) {
    if (valor === null || valor === undefined || valor === '') return null;
    const n = parseInt(valor, 10);
    return Number.isNaN(n) ? null : n;
  }

  function ubicacionFormulario(prefix) {
    const selTrayecto = document.getElementById(prefix + '-trayecto');
    const selTramo = document.getElementById(prefix + '-tramo');
    return {
      trayecto: enteroONulo(selTrayecto && selTrayecto.value),
      tramo: enteroONulo(selTramo && selTramo.value),
    };
  }

  function sincronizarTramosPorTrayecto(prefix, tramoSeleccionado) {
    const selTrayecto = document.getElementById(prefix + '-trayecto');
    const selTramo = document.getElementById(prefix + '-tramo');
    if (!selTrayecto || !selTramo) return;

    const trayecto = enteroONulo(selTrayecto.value);
    selTramo.innerHTML = '';

    if (trayecto === null) {
      const vacio = document.createElement('option');
      vacio.value = '';
      vacio.textContent = 'Sin tramo';
      selTramo.appendChild(vacio);
    } else {
      tramosDeTrayecto(trayecto).forEach(function(t) {
        const el = document.createElement('option');
        el.value = String(t);
        el.textContent = 'Tramo ' + t + ' (Trayecto ' + ROMANOS_TRAYECTO[trayecto] + ')';
        selTramo.appendChild(el);
      });
      const preferido = enteroONulo(tramoSeleccionado);
      if (preferido !== null && tramosDeTrayecto(trayecto).includes(preferido)) {
        selTramo.value = String(preferido);
      }
    }

    sincronizarPrelaciones(prefix);
  }

  function esAnterior(requisito, objetivo) {
    if (requisito.trayecto === null || requisito.tramo === null) return false;
    if (objetivo.trayecto === null || objetivo.tramo === null) return false;
    return requisito.trayecto < objetivo.trayecto ||
      (requisito.trayecto === objetivo.trayecto && requisito.tramo < objetivo.tramo);
  }

  function etiquetaUbicacion(uc) {
    if (uc.trayecto === null || uc.tramo === null) return 'Sin malla';
    return 'Tray. ' + ROMANOS_TRAYECTO[uc.trayecto] + ' · Tramo ' + uc.tramo;
  }

  function sincronizarPrelaciones(prefix) {
    const lista = document.getElementById(prefix + '-prel-lista');
    if (!lista) return;

    const objetivo = ubicacionFormulario(prefix);
    const seleccion = prelacionesSeleccionadas[prefix];
    const busqueda = (document.getElementById(prefix + '-prel-buscar').value || '')
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

    const candidatas = CATALOGO_PRELACIONES.filter(function(uc) {
      if (uc.id === unidadEnEdicion[prefix]) return false;
      return esAnterior(uc, objetivo) || seleccion.has(uc.id);
    });

    lista.innerHTML = '';
    let visibles = 0;

    candidatas.forEach(function(uc) {
      const valida = esAnterior(uc, objetivo);
      const item = document.createElement('label');
      item.className = 'prelacion-picker-item' +
        (seleccion.has(uc.id) ? ' is-checked' : '') + (valida ? '' : ' is-invalid');

      const check = document.createElement('input');
      check.type = 'checkbox';
      check.className = 'uk-checkbox';
      check.name = 'prelaciones';
      check.value = uc.id;
      check.checked = seleccion.has(uc.id);
      check.addEventListener('change', function() {
        if (check.checked) seleccion.add(uc.id);
        else seleccion.delete(uc.id);
        item.classList.toggle('is-checked', check.checked);
        actualizarContadorPrelaciones(prefix);
      });

      const codigo = document.createElement('span');
      codigo.className = 'prelacion-picker-code';
      codigo.textContent = uc.codigo;

      const nombre = document.createElement('span');
      nombre.className = 'prelacion-picker-name';
      nombre.textContent = uc.nombre + (uc.activa ? '' : ' (inactiva)');
      nombre.title = uc.nombre;

      const ubicacion = document.createElement('span');
      ubicacion.className = 'prelacion-picker-location';
      ubicacion.textContent = valida ? etiquetaUbicacion(uc) : 'No es anterior: se descartará';

      item.append(check, codigo, nombre, ubicacion);

      const texto = (uc.codigo + ' ' + uc.nombre).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      item.hidden = busqueda !== '' && !texto.includes(busqueda);
      if (!item.hidden) visibles += 1;
      lista.appendChild(item);
    });

    if (visibles === 0) {
      const vacio = document.createElement('div');
      vacio.className = 'prelacion-picker-empty';
      vacio.textContent = objetivo.trayecto === null || objetivo.tramo === null
        ? 'Seleccione Trayecto y Tramo para ver las unidades que pueden prelar.'
        : candidatas.length === 0
          ? 'No hay unidades en un Trayecto/Tramo anterior.'
          : 'Ninguna unidad coincide con la búsqueda.';
      lista.appendChild(vacio);
    }

    actualizarContadorPrelaciones(prefix);
  }

  function actualizarContadorPrelaciones(prefix) {
    const contador = document.getElementById(prefix + '-prel-contador');
    if (!contador) return;
    const total = prelacionesSeleccionadas[prefix].size;
    contador.textContent = total === 1 ? '1 seleccionada' : total + ' seleccionadas';
  }

  function avisoUbicacion(uc) {
    if (!REQUIERE_TRAYECTO) return '';
    if (uc.trayecto === null || uc.tramo === null) {
      return 'Esta unidad llegó desde la oferta con la ubicación incompleta (' +
        (uc.trayecto === null ? 'sin trayecto' : 'Trayecto ' + uc.trayecto + ' sin tramo') +
        '). Se precargó una ubicación válida: confírmela o corríjala antes de guardar.';
    }
    if (!tramosDeTrayecto(uc.trayecto).includes(uc.tramo)) {
      return 'La ubicación registrada (Trayecto ' + uc.trayecto + ', Tramo ' + uc.tramo +
        ') no cumple RC-06. Se precargó el primer tramo válido del trayecto: corríjalo antes de guardar.';
    }
    return '';
  }

  function abrirModalEditarUnidad(uc) {
    const form = document.getElementById('form-editar-uc');
    form.action = '/curriculo/unidades/' + uc.id + '/editar';

    document.getElementById('edit-codigo').value = uc.codigo;
    document.getElementById('edit-nombre').value = uc.nombre;
    document.getElementById('edit-creditos').value = uc.creditos;
    document.getElementById('edit-ht').value = uc.horasTeoricasSemanales;
    document.getElementById('edit-hp').value = uc.horasPracticasSemanales;
    document.getElementById('edit-hc').value = uc.horasCampoComunitarioSemanales;
    document.getElementById('edit-tipoEspacio').value = uc.tipoEspacioRequerido;
    document.getElementById('edit-esProyecto').checked = Boolean(uc.esProyectoComunitario);

    unidadEnEdicion.edit = uc.id;
    prelacionesSeleccionadas.edit = new Set((uc.prelacionesRequeridas || []).map(function(p) { return p.preladaPorId; }));
    const buscador = document.getElementById('edit-prel-buscar');
    if (buscador) buscador.value = '';

    let trayecto = uc.trayecto;
    if (trayecto === null && REQUIERE_TRAYECTO) {
      trayecto = uc.tramo !== null ? trayectoDeTramo(uc.tramo) : 1;
    }
    document.getElementById('edit-trayecto').value = trayecto === null ? '' : String(trayecto);
    sincronizarTramosPorTrayecto('edit', uc.tramo);

    const aviso = avisoUbicacion(uc);
    document.getElementById('edit-aviso-ubicacion-texto').textContent = aviso;
    document.getElementById('edit-aviso-ubicacion').hidden = aviso === '';

    actualizarEstimacionSolver('edit');
    UIkit.modal('#modal-editar-unidad').show();
  }

  document.addEventListener('DOMContentLoaded', function() {
    sincronizarTramosPorTrayecto('nuevo');
  });
</script>
