<!-- Scripts de Interacción de la Vista de Espacios -->
<script>
  function abrirModalEditarAula(id, codigo, nombre, tipo, capacidad, piso) {
    const form = document.getElementById('form-editar-aula');
    form.action = '/espacios/aulas/' + id + '/editar';

    document.getElementById('edit-aula-codigo').value = codigo;
    document.getElementById('edit-aula-nombre').value = nombre;
    document.getElementById('edit-aula-tipo').value = tipo;
    document.getElementById('edit-aula-capacidad').value = capacidad;
    document.getElementById('edit-aula-piso').value = piso;

    UIkit.modal('#modal-editar-aula').show();
  }

  function abrirModalEditarSede(id, codigo, nombre, eje, direccion, esAldea) {
    const form = document.getElementById('form-editar-sede');
    form.action = '/espacios/sedes/' + id + '/editar';

    document.getElementById('edit-sede-codigo').value = codigo;
    document.getElementById('edit-sede-nombre').value = nombre;
    document.getElementById('edit-sede-eje').value = eje;
    document.getElementById('edit-sede-direccion').value = direccion;
    document.getElementById('edit-sede-esAldea').checked = Boolean(esAldea);

    UIkit.modal('#modal-editar-sede').show();
  }

  function limpiarFiltrosEspacio(e) {
    if (e) e.preventDefault();
    const form = document.getElementById('espacios-filter-form');
    if (!form) return;
    const inputQ = form.querySelector('input[name="q"]');
    const selectSede = form.querySelector('select[name="sedeId"]');
    const selectTipo = form.querySelector('select[name="tipo"]');
    const selectEstado = form.querySelector('select[name="estado"]');
    if (inputQ) inputQ.value = '';
    if (selectSede) selectSede.value = '';
    if (selectTipo) selectTipo.value = '';
    if (selectEstado) selectEstado.value = '';
    const resetBtn = document.getElementById('btn-limpiar-espacios');
    if (resetBtn) resetBtn.classList.add('uk-hidden');
    htmx.trigger(form, 'submit');
  }

  // Alternar botón Limpiar al escribir
  document.addEventListener('input', function(e) {
    if (e.target && e.target.name === 'q' && e.target.id === 'espacio-search-input') {
      const resetBtn = document.getElementById('btn-limpiar-espacios');
      if (resetBtn) {
        resetBtn.classList.toggle('uk-hidden', !e.target.value.trim());
      }
    }
  });
</script>
